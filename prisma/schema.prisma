// ═══════════════════════════════════════════════════════════════════════════
// Mind Fitness Club · esquema de base de datos
//
// FASE 1 · Fundaciones: identidad, RBAC, sesiones, auditoría, configuración
// e infraestructura transversal (idempotencia, outbox, jobs).
//
// Convenciones (docs/01-arquitectura.md §7):
//   · PK uuid v7 — ordenable en el tiempo, no filtra volumen de negocio
//   · Dinero: BigInt en unidades menores (COP exponente 0 → 1 = $1)
//   · Fechas de negocio: DateTime @db.Date, calculadas en America/Bogota
//   · Marcas de tiempo: @db.Timestamptz(3), siempre UTC
//   · Prohibido DELETE en información financiera y en auditoría
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  // `relationJoins` resuelve los `include` anidados con LATERAL JOIN, en UNA
  // sola ida y vuelta. Con la base en otra región cada viaje cuesta ~410 ms,
  // así que un include de 3 niveles pasaba de 1.250 ms a ~420 ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Conexión que usa la aplicación. En producción sobre Supabase será el
  // pooler de transacciones (puerto 6543) con `?pgbouncer=true`.
  url       = env("DATABASE_URL")
  // Conexión directa, obligatoria para `prisma migrate`: las migraciones
  // necesitan sentencias que el pooler de transacciones no admite.
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTIDAD Y ACCESO
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  phone              String?
  avatarUrl          String?   @map("avatar_url")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  // Defensa contra fuerza bruta. Se limpia al iniciar sesión con éxito.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique
  name        String
  description String?
  // Los roles del sistema no se pueden eliminar; sus permisos sí se editan.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo cerrado, sembrado desde src/shared/constants/permissions.ts.
/// No se crea ni se elimina desde la interfaz.
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Sesión en base de datos, no JWT: permite revocación inmediata (RN-90).
/// Se guarda el hash del token, nunca el token.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA — bitácora inmutable (RN-91)
// Se escribe DENTRO de la transacción del cambio. Sin UPDATE ni DELETE.
// ═══════════════════════════════════════════════════════════════════════════

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  // El correo y el rol se copian: la bitácora sobrevive al borrado del usuario.
  actorId    String? @map("actor_id") @db.Uuid
  actorEmail String? @map("actor_email")
  actorRole  String? @map("actor_role")

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  before Json?
  after  Json?
  reason String?

  ip        String?
  userAgent String? @map("user_agent")
  sessionId String? @map("session_id")
  requestId String? @map("request_id")

  severity  AuditSeverity @default(INFO)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN — clave/valor tipado y agrupado
// Toda regla configurable pasa por aquí. Nada de reglas en el código.
// ═══════════════════════════════════════════════════════════════════════════

enum SettingGroup {
  business
  branding
  rules
  payments
  legal
  messaging
  integrations
}

enum SettingType {
  string
  number
  boolean
  json
  date
  money
}

model BusinessSetting {
  id          String       @id @default(uuid(7)) @db.Uuid
  key         String       @unique
  group       SettingGroup
  value       Json
  type        SettingType
  /// Se cifra en reposo y se enmascara en la interfaz (llaves de integraciones).
  isSensitive Boolean      @default(false) @map("is_sensitive")
  description String?
  updatedBy   String?      @map("updated_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([group])
  @@map("business_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENTES  ·  Fase 2
// ═══════════════════════════════════════════════════════════════════════════

enum DocumentType {
  CC // cédula de ciudadanía
  CE // cédula de extranjería
  TI // tarjeta de identidad
  PA // pasaporte
  NIT
  PEP // permiso especial de permanencia
  PPT // permiso por protección temporal
}

/// Anulación manual del estado calculado. Todo lo demás se deriva de la
/// membresía vigente (docs/05-flujos-y-estados.md §10).
enum ClientStatusOverride {
  BLOCKED
  INACTIVE
}

model Client {
  id String @id @default(uuid(7)) @db.Uuid

  /// Reservado para el portal del miembro (Fase v2.0).
  userId String? @unique @map("user_id") @db.Uuid
  /// Consecutivo legible: MFC-00001
  code   String  @unique

  firstName String @map("first_name")
  lastName  String @map("last_name")

  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number")

  birthDate DateTime? @map("birth_date") @db.Date
  gender    String?

  phone    String
  whatsapp String?
  email    String?
  address  String?
  city     String?
  photoUrl String? @map("photo_url")

  /// Canal de adquisición. Catálogo configurable, no un enum cerrado.
  acquisitionChannel String?  @map("acquisition_channel")
  registeredAt       DateTime @default(now()) @map("registered_at") @db.Timestamptz(3)

  statusOverride       ClientStatusOverride? @map("status_override")
  statusOverrideReason String?               @map("status_override_reason")

  /// Reservado para el check-in por QR (Fase v2.2).
  accessCode String? @unique @map("access_code")

  /// Texto normalizado (sin tildes, minúsculas) para la búsqueda rápida.
  searchText String @default("") @map("search_text")

  /// Fusión de duplicados: el registro absorbido conserva a quién apunta.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  emergencyContacts EmergencyContact[]
  notes             ClientNote[]
  documents         ClientDocument[]
  consents          Consent[]

  @@unique([documentType, documentNumber])
  @@index([searchText])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
  @@map("clients")
}

model EmergencyContact {
  id           String  @id @default(uuid(7)) @db.Uuid
  clientId     String  @map("client_id") @db.Uuid
  name         String
  relationship String?
  phone        String
  isPrimary    Boolean @default(true) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("emergency_contacts")
}

enum NoteVisibility {
  INTERNAL
  TRAINER
}

/// Inmutable: una observación no se edita, se corrige añadiendo otra.
model ClientNote {
  id         String         @id @default(uuid(7)) @db.Uuid
  clientId   String         @map("client_id") @db.Uuid
  authorId   String?        @map("author_id") @db.Uuid
  authorName String         @map("author_name")
  body       String
  visibility NoteVisibility @default(INTERNAL)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

model ClientDocument {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  type      String
  fileKey   String   @map("file_key")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  uploadedBy String? @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("documents")
}

enum ConsentType {
  TERMS
  DATA_PROCESSING
  IMAGE_RIGHTS
  HEALTH_DECLARATION
}

enum ConsentChannel {
  WEB
  ONSITE
}

/// Se guarda la VERSIÓN del texto aceptado: actualizar los términos no
/// reescribe los consentimientos ya firmados (RN-84).
model Consent {
  id              String         @id @default(uuid(7)) @db.Uuid
  clientId        String         @map("client_id") @db.Uuid
  type            ConsentType
  documentVersion String         @map("document_version")
  acceptedAt      DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ip              String?
  userAgent       String?        @map("user_agent")
  channel         ConsentChannel
  signatureUrl    String?        @map("signature_url")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, type])
  @@map("consents")
}

model Holiday {
  id               String   @id @default(uuid(7)) @db.Uuid
  date             DateTime @unique @db.Date
  name             String
  blocksOperations Boolean  @default(false) @map("blocks_operations")

  @@map("holidays")
}

/// Consecutivo de códigos de cliente. Una fila por secuencia; se incrementa
/// dentro de la transacción para no dejar huecos ni repetir bajo concurrencia.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

// ═══════════════════════════════════════════════════════════════════════════
// SERVICIOS, PLANES Y MEMBRESÍAS  ·  Fase 3
//
// Decisión estructural (docs/12-servicios-y-entrenadores.md):
// `plans.modality` es la etiqueta comercial; los DERECHOS son la verdad
// operativa. Sin esto es imposible calcular «su plan no incluye acompañamiento»
// o «le quedan 3 sesiones», que es lo que el entrenador necesita saber.
// ═══════════════════════════════════════════════════════════════════════════

enum ServiceKind {
  ACCESS
  TRAINING
  CLASS
  EVENT
  ADDON
}

enum ServiceUnit {
  UNLIMITED
  SESSION
  HOUR
  CLASS
  MONTH
}

/// Catálogo de lo que el gimnasio ofrece. Editable desde Configuración.
model Service {
  id          String      @id @default(uuid(7)) @db.Uuid
  code        String      @unique
  name        String
  description String?
  kind        ServiceKind
  unit        ServiceUnit
  /// Clave para las alertas: si el servicio implica acompañamiento.
  requiresTrainer Boolean @default(false) @map("requires_trainer")
  /// Precio si se vende suelto o como excepción autorizada.
  standalonePrice BigInt? @map("standalone_price")
  icon        String?
  isActive    Boolean     @default(true) @map("is_active")
  sortOrder   Int         @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  planEntitlements       PlanEntitlement[]
  membershipEntitlements MembershipEntitlement[]
  usages                 ServiceUsage[]
  authorizations         ServiceAuthorization[]

  @@map("services")
}

enum DurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum PlanModality {
  OPEN
  GROUP
  SEMI_PERSONAL
  PERSONAL
}

enum PlanStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

enum EntitlementPeriod {
  TOTAL
  DAY
  WEEK
  MONTH
}

/// Producto del catálogo. Los 10 tipos de plan salen de COMBINAR estos campos:
/// no existe una columna `plan_type` ni un `if (plan === 'MENSUAL')`.
model Plan {
  id          String  @id @default(uuid(7)) @db.Uuid
  slug        String  @unique
  name        String
  description String?

  price    BigInt
  currency String @default("COP")

  durationValue Int?          @map("duration_value")
  durationUnit  DurationUnit? @map("duration_unit")
  sessionLimit  Int?          @map("session_limit")

  weeklyVisitLimit  Int? @map("weekly_visit_limit")
  monthlyVisitLimit Int? @map("monthly_visit_limit")
  dailyVisitLimit   Int  @default(1) @map("daily_visit_limit")

  modality        PlanModality @default(OPEN)
  requiresSchedule Boolean     @default(false) @map("requires_schedule")
  maxCapacity     Int?         @map("max_capacity")
  graceDays       Int          @default(0) @map("grace_days")

  allowsDiscount     Boolean @default(true) @map("allows_discount")
  maxDiscountPercent Int?    @map("max_discount_percent")
  promoPrice         BigInt? @map("promo_price")
  promoStartsAt      DateTime? @map("promo_starts_at") @db.Date
  promoEndsAt        DateTime? @map("promo_ends_at") @db.Date

  isPublic                 Boolean @default(false) @map("is_public")
  /// Cinta «RECOMENDADO» de la tabla de precios. Solo uno a la vez.
  isRecommended            Boolean @default(false) @map("is_recommended")
  allowsOnlineRegistration Boolean @default(false) @map("allows_online_registration")
  allowsOnlinePayment      Boolean @default(false) @map("allows_online_payment")
  autoRenew                Boolean @default(false) @map("auto_renew")

  status    PlanStatus @default(DRAFT)
  benefits  Json       @default("[]")
  rules     Json       @default("{}")
  sortOrder Int        @default(0) @map("sort_order")

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  entitlements PlanEntitlement[]
  memberships  Membership[]

  @@index([status, isPublic])
  @@map("plans")
}

/// Qué servicios incluye un plan y con qué límites.
model PlanEntitlement {
  id        String @id @default(uuid(7)) @db.Uuid
  planId    String @map("plan_id") @db.Uuid
  serviceId String @map("service_id") @db.Uuid

  /// Nulo = ilimitado.
  quantity Int?
  period   EntitlementPeriod @default(TOTAL)
  /// ¿Lo no usado pasa al periodo siguiente? P32: no, por defecto.
  rollover Boolean @default(false)
  notes    String?

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceId])
  @@map("plan_entitlements")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  PAUSED
  EXPIRED
  COMPLETED
  CANCELLED
  SUPERSEDED
}

enum MembershipSource {
  WEB
  ONSITE
  IMPORT
  RENEWAL
}

/// El contrato: la aplicación de un plan a una persona concreta.
/// Sus condiciones económicas son INMUTABLES (`planSnapshot`): si el plan sube
/// de precio, ninguna membresía anterior cambia.
model Membership {
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.Uuid
  planId   String @map("plan_id") @db.Uuid

  /// 🔒 Copia íntegra del plan al vender: precio, duración, límites y reglas.
  planSnapshot Json @map("plan_snapshot")

  listPrice          BigInt  @map("list_price")
  discountAmount     BigInt  @default(0) @map("discount_amount")
  discountReason     String? @map("discount_reason")
  discountApprovedBy String? @map("discount_approved_by") @db.Uuid
  finalPrice         BigInt  @map("final_price")

  startDate DateTime  @map("start_date") @db.Date
  /// Nulo en planes solo por sesiones.
  endDate   DateTime? @map("end_date") @db.Date

  sessionsIncluded Int? @map("sessions_included")
  sessionsUsed     Int  @default(0) @map("sessions_used")

  status MembershipStatus @default(PENDING)

  pausedAt        DateTime? @map("paused_at") @db.Timestamptz(3)
  pausedDaysTotal Int       @default(0) @map("paused_days_total")
  courtesyDays    Int       @default(0) @map("courtesy_days")

  trainerId      String? @map("trainer_id") @db.Uuid
  scheduleSlotId String? @map("schedule_slot_id") @db.Uuid

  previousMembershipId String?          @map("previous_membership_id") @db.Uuid
  source               MembershipSource @default(ONSITE)

  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason")
  notes        String?

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  plan         Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlements MembershipEntitlement[]
  changes      MembershipChange[]
  usages       ServiceUsage[]

  @@index([clientId, status])
  @@index([status, endDate])
  @@map("memberships")
}

enum EntitlementStatus {
  ACTIVE
  EXHAUSTED
  SUSPENDED
  EXPIRED
}

enum EntitlementSource {
  PLAN
  ADDON
  AUTHORIZATION
  COURTESY
  EVENT
}

/// Los derechos DE ESTA PERSONA, congelados y con sus propios contadores.
/// Es lo que lee la tarjeta del entrenador.
model MembershipEntitlement {
  id           String @id @default(uuid(7)) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  serviceId    String @map("service_id") @db.Uuid

  /// Copia de la regla del plan en el momento de vender.
  snapshot Json

  quantityTotal    Int? @map("quantity_total")
  quantityUsed     Int  @default(0) @map("quantity_used")
  quantityReserved Int  @default(0) @map("quantity_reserved")

  period      EntitlementPeriod @default(TOTAL)
  periodStart DateTime?         @map("period_start") @db.Date
  periodEnd   DateTime?         @map("period_end") @db.Date
  rollover    Boolean           @default(false)

  status EntitlementStatus @default(ACTIVE)
  /// Permite añadir derechos sin tocar el plan: sesión extra, cortesía…
  source EntitlementSource @default(PLAN)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service    Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  usages     ServiceUsage[]

  @@index([membershipId, status])
  @@map("membership_entitlements")
}

model MembershipChange {
  id           String   @id @default(uuid(7)) @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  action       String
  before       Json?
  after        Json?
  reason       String?
  performedBy  String?  @map("performed_by") @db.Uuid
  performedAt  DateTime @default(now()) @map("performed_at") @db.Timestamptz(3)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([membershipId, performedAt])
  @@map("membership_changes")
}

/// Cada vez que se presta un servicio. Bisagra entre el contador del cliente,
/// el devengo del entrenador y el reporte de rentabilidad.
model ServiceUsage {
  id                      String  @id @default(uuid(7)) @db.Uuid
  clientId                String  @map("client_id") @db.Uuid
  membershipId            String? @map("membership_id") @db.Uuid
  membershipEntitlementId String? @map("membership_entitlement_id") @db.Uuid
  serviceId               String  @map("service_id") @db.Uuid
  trainerId               String? @map("trainer_id") @db.Uuid
  scheduleSlotId          String? @map("schedule_slot_id") @db.Uuid

  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  businessDate DateTime @map("business_date") @db.Date
  quantity     Int      @default(1)

  /// Falso cuando se prestó fuera de lo contratado: el servicio ocurrió y no
  /// se borra, pero queda marcado para revisión.
  wasWithinEntitlement Boolean @default(true) @map("was_within_entitlement")
  authorizationId      String? @map("authorization_id") @db.Uuid

  registeredBy String? @map("registered_by") @db.Uuid
  notes        String?

  membership  Membership?            @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  entitlement MembershipEntitlement? @relation(fields: [membershipEntitlementId], references: [id], onDelete: SetNull)
  service     Service                @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  trainer     Trainer?               @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@index([clientId, businessDate])
  @@index([trainerId, businessDate])
  @@map("service_usages")
}

enum AuthorizationStatus {
  REQUESTED
  APPROVED
  REJECTED
  APPLIED
  EXPIRED
  CANCELLED
}

/// Excepción controlada: prestar algo que el plan no incluye.
model ServiceAuthorization {
  id           String  @id @default(uuid(7)) @db.Uuid
  clientId     String  @map("client_id") @db.Uuid
  membershipId String? @map("membership_id") @db.Uuid
  serviceId    String  @map("service_id") @db.Uuid

  requestedBy String   @map("requested_by") @db.Uuid
  requestedAt DateTime @default(now()) @map("requested_at") @db.Timestamptz(3)
  reason      String

  status        AuthorizationStatus @default(REQUESTED)
  decidedBy     String?             @map("decided_by") @db.Uuid
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNotes String?             @map("decision_notes")

  effectCharge           Boolean @default(false) @map("effect_charge")
  chargeAmount           BigInt? @map("charge_amount")
  effectConsumeSession   Boolean @default(false) @map("effect_consume_session")
  effectGrantEntitlement Boolean @default(false) @map("effect_grant_entitlement")

  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  appliedAt  DateTime? @map("applied_at") @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([clientId])
  @@map("service_authorizations")
}

// ═══════════════════════════════════════════════════════════════════════════
// ENTRENADORES Y HORARIOS
// ═══════════════════════════════════════════════════════════════════════════

model Trainer {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String? @unique @map("user_id") @db.Uuid

  fullName       String  @map("full_name")
  documentNumber String? @map("document_number")
  phone          String?
  email          String?
  specialties    Json    @default("[]")
  bio            String?
  photoUrl       String? @map("photo_url")

  isActive Boolean @default(true) @map("is_active")
  isPublic Boolean @default(false) @map("is_public")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  slots       ScheduleSlot[]
  assignments TrainerAssignment[]
  usages      ServiceUsage[]

  @@map("trainers")
}

enum AssignmentScope {
  CLIENT
  MEMBERSHIP
  SLOT
  PLAN
  EVENT
  TEMPORARY
}

enum AssignmentRole {
  PRIMARY
  SUPPORT
  SUBSTITUTE
}

enum AssignmentStatus {
  ACTIVE
  SCHEDULED
  ENDED
  CANCELLED
}

/// Las seis formas de asignación en UNA tabla polimórfica.
/// Precedencia al resolver «¿quién atiende ahora?»:
/// TEMPORARY > MEMBERSHIP > CLIENT > SLOT > PLAN.
model TrainerAssignment {
  id        String          @id @default(uuid(7)) @db.Uuid
  trainerId String          @map("trainer_id") @db.Uuid
  scope     AssignmentScope

  clientId       String? @map("client_id") @db.Uuid
  membershipId   String? @map("membership_id") @db.Uuid
  scheduleSlotId String? @map("schedule_slot_id") @db.Uuid
  planId         String? @map("plan_id") @db.Uuid
  eventId        String? @map("event_id") @db.Uuid

  role      AssignmentRole @default(PRIMARY)
  serviceId String?        @map("service_id") @db.Uuid

  startsAt DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(3)

  sessionsTotal     Int? @map("sessions_total")
  sessionsDelivered Int  @default(0) @map("sessions_delivered")

  status               AssignmentStatus @default(ACTIVE)
  replacesAssignmentId String?          @map("replaces_assignment_id") @db.Uuid
  notes                String?
  createdBy            String?          @map("created_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, status])
  @@index([clientId, status])
  @@index([scheduleSlotId, status])
  @@map("trainer_assignments")
}

model Schedule {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  slots ScheduleSlot[]

  @@map("schedules")
}

/// Franja recurrente: día de la semana + hora + capacidad.
model ScheduleSlot {
  id         String @id @default(uuid(7)) @db.Uuid
  scheduleId String @map("schedule_id") @db.Uuid
  name       String?

  /// 0 domingo … 6 sábado
  weekday   Int
  startTime String @map("start_time") // 'HH:MM'
  endTime   String @map("end_time")
  capacity  Int

  trainerId String? @map("trainer_id") @db.Uuid
  isActive  Boolean @default(true) @map("is_active")

  validFrom  DateTime  @default(now()) @map("valid_from") @db.Date
  validUntil DateTime? @map("valid_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  schedule    Schedule         @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  trainer     Trainer?         @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  enrollments SlotEnrollment[]
  occurrences SlotOccurrence[]

  @@index([weekday, isActive])
  @@map("schedule_slots")
}

enum OccurrenceStatus {
  SCHEDULED
  CANCELLED
  BLOCKED
  MODIFIED
}

/// Instancia de una fecha concreta. Solo se crea cuando hay una EXCEPCIÓN:
/// materializar todas las ocurrencias del año sería basura.
model SlotOccurrence {
  id             String           @id @default(uuid(7)) @db.Uuid
  scheduleSlotId String           @map("schedule_slot_id") @db.Uuid
  date           DateTime         @db.Date
  status         OccurrenceStatus @default(SCHEDULED)

  capacityOverride Int?    @map("capacity_override")
  trainerOverride  String? @map("trainer_override") @db.Uuid
  reason           String?
  createdBy        String? @map("created_by") @db.Uuid

  slot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)

  @@unique([scheduleSlotId, date])
  @@map("slot_occurrences")
}

enum EnrollmentStatus {
  ACTIVE
  RESERVED
  MOVED
  CANCELLED
}

model SlotEnrollment {
  id             String @id @default(uuid(7)) @db.Uuid
  scheduleSlotId String @map("schedule_slot_id") @db.Uuid
  clientId       String @map("client_id") @db.Uuid
  membershipId   String? @map("membership_id") @db.Uuid

  status EnrollmentStatus @default(ACTIVE)
  /// Retención temporal durante el checkout.
  reservedUntil  DateTime? @map("reserved_until") @db.Timestamptz(3)
  movedToSlotId  String?   @map("moved_to_slot_id") @db.Uuid

  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  slot ScheduleSlot @relation(fields: [scheduleSlotId], references: [id], onDelete: Cascade)

  @@index([scheduleSlotId, status])
  @@index([clientId, status])
  @@map("slot_enrollments")
}

// ═══════════════════════════════════════════════════════════════════════════
// INFRAESTRUCTURA TRANSVERSAL
// ═══════════════════════════════════════════════════════════════════════════

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Evita ejecutar dos veces la misma operación (doble clic, reintento, webhook).
model IdempotencyKey {
  key         String            @id
  scope       String
  requestHash String            @map("request_hash")
  status      IdempotencyStatus @default(IN_PROGRESS)
  response    Json?
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Efectos secundarios encolados DENTRO de la transacción del hecho que los
/// origina: correo, notificación, webhook saliente. Si la operación falla no
/// hay efecto fantasma; si tiene éxito, el efecto está garantizado (RN-160).
model OutboxMessage {
  id          String       @id @default(uuid(7)) @db.Uuid
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  nextRetryAt DateTime?    @map("next_retry_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextRetryAt])
  @@map("outbox")
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Trazabilidad de los procesos programados. Los estados de negocio son
/// derivados (RN-03), así que un job caído no corrompe datos: solo retrasa
/// notificaciones. Esta tabla permite detectarlo.
model JobRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  jobName        String    @map("job_name")
  status         JobStatus @default(RUNNING)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  itemsProcessed Int       @default(0) @map("items_processed")
  error          String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}
