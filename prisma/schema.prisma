// ═══════════════════════════════════════════════════════════════════════════
// Mind Fitness Club · esquema de base de datos
//
// FASE 1 · Fundaciones: identidad, RBAC, sesiones, auditoría, configuración
// e infraestructura transversal (idempotencia, outbox, jobs).
//
// Convenciones (docs/01-arquitectura.md §7):
//   · PK uuid v7 — ordenable en el tiempo, no filtra volumen de negocio
//   · Dinero: BigInt en unidades menores (COP exponente 0 → 1 = $1)
//   · Fechas de negocio: DateTime @db.Date, calculadas en America/Bogota
//   · Marcas de tiempo: @db.Timestamptz(3), siempre UTC
//   · Prohibido DELETE en información financiera y en auditoría
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  // `relationJoins` resuelve los `include` anidados con LATERAL JOIN, en UNA
  // sola ida y vuelta. Con la base en otra región cada viaje cuesta ~410 ms,
  // así que un include de 3 niveles pasaba de 1.250 ms a ~420 ms.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Conexión que usa la aplicación. En producción sobre Supabase será el
  // pooler de transacciones (puerto 6543) con `?pgbouncer=true`.
  url       = env("DATABASE_URL")
  // Conexión directa, obligatoria para `prisma migrate`: las migraciones
  // necesitan sentencias que el pooler de transacciones no admite.
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTIDAD Y ACCESO
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  phone              String?
  avatarUrl          String?   @map("avatar_url")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  // Defensa contra fuerza bruta. Se limpia al iniciar sesión con éxito.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique
  name        String
  description String?
  // Los roles del sistema no se pueden eliminar; sus permisos sí se editan.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo cerrado, sembrado desde src/shared/constants/permissions.ts.
/// No se crea ni se elimina desde la interfaz.
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Sesión en base de datos, no JWT: permite revocación inmediata (RN-90).
/// Se guarda el hash del token, nunca el token.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA — bitácora inmutable (RN-91)
// Se escribe DENTRO de la transacción del cambio. Sin UPDATE ni DELETE.
// ═══════════════════════════════════════════════════════════════════════════

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  // El correo y el rol se copian: la bitácora sobrevive al borrado del usuario.
  actorId    String? @map("actor_id") @db.Uuid
  actorEmail String? @map("actor_email")
  actorRole  String? @map("actor_role")

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  before Json?
  after  Json?
  reason String?

  ip        String?
  userAgent String? @map("user_agent")
  sessionId String? @map("session_id")
  requestId String? @map("request_id")

  severity  AuditSeverity @default(INFO)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN — clave/valor tipado y agrupado
// Toda regla configurable pasa por aquí. Nada de reglas en el código.
// ═══════════════════════════════════════════════════════════════════════════

enum SettingGroup {
  business
  branding
  rules
  payments
  legal
  messaging
  integrations
}

enum SettingType {
  string
  number
  boolean
  json
  date
  money
}

model BusinessSetting {
  id          String       @id @default(uuid(7)) @db.Uuid
  key         String       @unique
  group       SettingGroup
  value       Json
  type        SettingType
  /// Se cifra en reposo y se enmascara en la interfaz (llaves de integraciones).
  isSensitive Boolean      @default(false) @map("is_sensitive")
  description String?
  updatedBy   String?      @map("updated_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([group])
  @@map("business_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// CLIENTES  ·  Fase 2
// ═══════════════════════════════════════════════════════════════════════════

enum DocumentType {
  CC // cédula de ciudadanía
  CE // cédula de extranjería
  TI // tarjeta de identidad
  PA // pasaporte
  NIT
  PEP // permiso especial de permanencia
  PPT // permiso por protección temporal
}

/// Anulación manual del estado calculado. Todo lo demás se deriva de la
/// membresía vigente (docs/05-flujos-y-estados.md §10).
enum ClientStatusOverride {
  BLOCKED
  INACTIVE
}

model Client {
  id String @id @default(uuid(7)) @db.Uuid

  /// Reservado para el portal del miembro (Fase v2.0).
  userId String? @unique @map("user_id") @db.Uuid
  /// Consecutivo legible: MFC-00001
  code   String  @unique

  firstName String @map("first_name")
  lastName  String @map("last_name")

  documentType   DocumentType @map("document_type")
  documentNumber String       @map("document_number")

  birthDate DateTime? @map("birth_date") @db.Date
  gender    String?

  phone    String
  whatsapp String?
  email    String?
  address  String?
  city     String?
  photoUrl String? @map("photo_url")

  /// Canal de adquisición. Catálogo configurable, no un enum cerrado.
  acquisitionChannel String?  @map("acquisition_channel")
  registeredAt       DateTime @default(now()) @map("registered_at") @db.Timestamptz(3)

  statusOverride       ClientStatusOverride? @map("status_override")
  statusOverrideReason String?               @map("status_override_reason")

  /// Reservado para el check-in por QR (Fase v2.2).
  accessCode String? @unique @map("access_code")

  /// Texto normalizado (sin tildes, minúsculas) para la búsqueda rápida.
  searchText String @default("") @map("search_text")

  /// Fusión de duplicados: el registro absorbido conserva a quién apunta.
  mergedIntoId String? @map("merged_into_id") @db.Uuid

  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  emergencyContacts EmergencyContact[]
  notes             ClientNote[]
  documents         ClientDocument[]
  consents          Consent[]

  @@unique([documentType, documentNumber])
  @@index([searchText])
  @@index([phone])
  @@index([email])
  @@index([deletedAt])
  @@map("clients")
}

model EmergencyContact {
  id           String  @id @default(uuid(7)) @db.Uuid
  clientId     String  @map("client_id") @db.Uuid
  name         String
  relationship String?
  phone        String
  isPrimary    Boolean @default(true) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("emergency_contacts")
}

enum NoteVisibility {
  INTERNAL
  TRAINER
}

/// Inmutable: una observación no se edita, se corrige añadiendo otra.
model ClientNote {
  id         String         @id @default(uuid(7)) @db.Uuid
  clientId   String         @map("client_id") @db.Uuid
  authorId   String?        @map("author_id") @db.Uuid
  authorName String         @map("author_name")
  body       String
  visibility NoteVisibility @default(INTERNAL)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("client_notes")
}

model ClientDocument {
  id        String   @id @default(uuid(7)) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  type      String
  fileKey   String   @map("file_key")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  sizeBytes Int      @map("size_bytes")
  uploadedBy String? @map("uploaded_by") @db.Uuid
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("documents")
}

enum ConsentType {
  TERMS
  DATA_PROCESSING
  IMAGE_RIGHTS
  HEALTH_DECLARATION
}

enum ConsentChannel {
  WEB
  ONSITE
}

/// Se guarda la VERSIÓN del texto aceptado: actualizar los términos no
/// reescribe los consentimientos ya firmados (RN-84).
model Consent {
  id              String         @id @default(uuid(7)) @db.Uuid
  clientId        String         @map("client_id") @db.Uuid
  type            ConsentType
  documentVersion String         @map("document_version")
  acceptedAt      DateTime       @default(now()) @map("accepted_at") @db.Timestamptz(3)
  ip              String?
  userAgent       String?        @map("user_agent")
  channel         ConsentChannel
  signatureUrl    String?        @map("signature_url")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, type])
  @@map("consents")
}

model Holiday {
  id               String   @id @default(uuid(7)) @db.Uuid
  date             DateTime @unique @db.Date
  name             String
  blocksOperations Boolean  @default(false) @map("blocks_operations")

  @@map("holidays")
}

/// Consecutivo de códigos de cliente. Una fila por secuencia; se incrementa
/// dentro de la transacción para no dejar huecos ni repetir bajo concurrencia.
model Counter {
  name  String @id
  value Int    @default(0)

  @@map("counters")
}

// ═══════════════════════════════════════════════════════════════════════════
// INFRAESTRUCTURA TRANSVERSAL
// ═══════════════════════════════════════════════════════════════════════════

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Evita ejecutar dos veces la misma operación (doble clic, reintento, webhook).
model IdempotencyKey {
  key         String            @id
  scope       String
  requestHash String            @map("request_hash")
  status      IdempotencyStatus @default(IN_PROGRESS)
  response    Json?
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Efectos secundarios encolados DENTRO de la transacción del hecho que los
/// origina: correo, notificación, webhook saliente. Si la operación falla no
/// hay efecto fantasma; si tiene éxito, el efecto está garantizado (RN-160).
model OutboxMessage {
  id          String       @id @default(uuid(7)) @db.Uuid
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  nextRetryAt DateTime?    @map("next_retry_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextRetryAt])
  @@map("outbox")
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Trazabilidad de los procesos programados. Los estados de negocio son
/// derivados (RN-03), así que un job caído no corrompe datos: solo retrasa
/// notificaciones. Esta tabla permite detectarlo.
model JobRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  jobName        String    @map("job_name")
  status         JobStatus @default(RUNNING)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  itemsProcessed Int       @default(0) @map("items_processed")
  error          String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}
