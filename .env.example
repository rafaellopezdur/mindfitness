# ─────────────────────────────────────────────────────────────
# Mind Fitness Club · variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# Ninguna llave secreta puede llevar el prefijo NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development

# ─── Base de datos PostgreSQL ───
# Supabase · Connect → "Session pooler" (puerto 5432) para AMBAS.
#
# Usar el pooler de SESIÓN, no el de transacciones: medido, el de transacciones
# cuesta 474 ms por consulta frente a 90 ms del de sesión, porque `pgbouncer=true`
# obliga a Prisma a renunciar a las sentencias preparadas. Ver ADR-0006.
# (Solo volver al de transacciones —6543 con ?pgbouncer=true— si algún día se
#  despliega en un entorno serverless.)
DATABASE_URL="postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Conexión para migraciones: siempre de sesión, nunca la agrupada por transacción.
DIRECT_URL="postgresql://postgres.xxxxxxxx:CONTRASENA@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# URL pública del sitio (enlaces de eventos, correos, webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Endpoints de cron: token compartido para llamadas firmadas
CRON_SECRET=""

# ─── Integraciones (adaptadores intercambiables) ───
# Pagos: mock | wompi | mercadopago | epayco     [TEMP: pendiente decisión — P1]
PAYMENT_PROVIDER="mock"
PAYMENT_PUBLIC_KEY=""
PAYMENT_PRIVATE_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# Correo transaccional: console | resend         [TEMP: pendiente — P9]
EMAIL_PROVIDER="console"
EMAIL_API_KEY=""
EMAIL_FROM="Mind Fitness Club <hola@mindfitnessclub.com.co>"

# Almacenamiento de documentos: local | s3       [TEMP: pendiente — P13]
STORAGE_PROVIDER="local"
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# Observabilidad (opcional)
SENTRY_DSN=""
