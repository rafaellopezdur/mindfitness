// ═══════════════════════════════════════════════════════════════════════════
// Mind Fitness Club · esquema de base de datos
//
// FASE 1 · Fundaciones: identidad, RBAC, sesiones, auditoría, configuración
// e infraestructura transversal (idempotencia, outbox, jobs).
//
// Convenciones (docs/01-arquitectura.md §7):
//   · PK uuid v7 — ordenable en el tiempo, no filtra volumen de negocio
//   · Dinero: BigInt en unidades menores (COP exponente 0 → 1 = $1)
//   · Fechas de negocio: DateTime @db.Date, calculadas en America/Bogota
//   · Marcas de tiempo: @db.Timestamptz(3), siempre UTC
//   · Prohibido DELETE en información financiera y en auditoría
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Conexión que usa la aplicación. En producción sobre Supabase será el
  // pooler de transacciones (puerto 6543) con `?pgbouncer=true`.
  url       = env("DATABASE_URL")
  // Conexión directa, obligatoria para `prisma migrate`: las migraciones
  // necesitan sentencias que el pooler de transacciones no admite.
  directUrl = env("DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTIDAD Y ACCESO
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @map("full_name")
  phone              String?
  avatarUrl          String?   @map("avatar_url")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)

  // Defensa contra fuerza bruta. Se limpia al iniciar sesión con éxito.
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(3)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique
  name        String
  description String?
  // Los roles del sistema no se pueden eliminar; sus permisos sí se editan.
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

/// Catálogo cerrado, sembrado desde src/shared/constants/permissions.ts.
/// No se crea ni se elimina desde la interfaz.
model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  grantedAt DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Sesión en base de datos, no JWT: permite revocación inmediata (RN-90).
/// Se guarda el hash del token, nunca el token.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ═══════════════════════════════════════════════════════════════════════════
// AUDITORÍA — bitácora inmutable (RN-91)
// Se escribe DENTRO de la transacción del cambio. Sin UPDATE ni DELETE.
// ═══════════════════════════════════════════════════════════════════════════

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

model AuditLog {
  id String @id @default(uuid(7)) @db.Uuid

  // El correo y el rol se copian: la bitácora sobrevive al borrado del usuario.
  actorId    String? @map("actor_id") @db.Uuid
  actorEmail String? @map("actor_email")
  actorRole  String? @map("actor_role")

  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id")

  before Json?
  after  Json?
  reason String?

  ip        String?
  userAgent String? @map("user_agent")
  sessionId String? @map("session_id")
  requestId String? @map("request_id")

  severity  AuditSeverity @default(INFO)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN — clave/valor tipado y agrupado
// Toda regla configurable pasa por aquí. Nada de reglas en el código.
// ═══════════════════════════════════════════════════════════════════════════

enum SettingGroup {
  business
  branding
  rules
  payments
  legal
  messaging
  integrations
}

enum SettingType {
  string
  number
  boolean
  json
  date
  money
}

model BusinessSetting {
  id          String       @id @default(uuid(7)) @db.Uuid
  key         String       @unique
  group       SettingGroup
  value       Json
  type        SettingType
  /// Se cifra en reposo y se enmascara en la interfaz (llaves de integraciones).
  isSensitive Boolean      @default(false) @map("is_sensitive")
  description String?
  updatedBy   String?      @map("updated_by") @db.Uuid
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([group])
  @@map("business_settings")
}

// ═══════════════════════════════════════════════════════════════════════════
// INFRAESTRUCTURA TRANSVERSAL
// ═══════════════════════════════════════════════════════════════════════════

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

/// Evita ejecutar dos veces la misma operación (doble clic, reintento, webhook).
model IdempotencyKey {
  key         String            @id
  scope       String
  requestHash String            @map("request_hash")
  status      IdempotencyStatus @default(IN_PROGRESS)
  response    Json?
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Efectos secundarios encolados DENTRO de la transacción del hecho que los
/// origina: correo, notificación, webhook saliente. Si la operación falla no
/// hay efecto fantasma; si tiene éxito, el efecto está garantizado (RN-160).
model OutboxMessage {
  id          String       @id @default(uuid(7)) @db.Uuid
  topic       String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  nextRetryAt DateTime?    @map("next_retry_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextRetryAt])
  @@map("outbox")
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// Trazabilidad de los procesos programados. Los estados de negocio son
/// derivados (RN-03), así que un job caído no corrompe datos: solo retrasa
/// notificaciones. Esta tabla permite detectarlo.
model JobRun {
  id             String    @id @default(uuid(7)) @db.Uuid
  jobName        String    @map("job_name")
  status         JobStatus @default(RUNNING)
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  itemsProcessed Int       @default(0) @map("items_processed")
  error          String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}
